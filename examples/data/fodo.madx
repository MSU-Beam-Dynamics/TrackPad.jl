! 10 m FODO cell with separated-function dipoles and chromatic sextupoles.
BEAM, PARTICLE=ELECTRON, ENERGY=3.00051099895069;

QFH: QUADRUPOLE, L=0.10, K1=1.414213562373095;
QD:  QUADRUPOLE, L=0.20, K1=-1.414213562373095;
SF:  SEXTUPOLE, L=0.05, K2=8.0;
SD:  SEXTUPOLE, L=0.05, K2=-8.0;
B1:  SBEND, L=3.60, ANGLE=0.03;
B2:  SBEND, L=3.60, ANGLE=0.03;

DQS: DRIFT, L=0.05;
DQB: DRIFT, L=0.50;

FODO: LINE=(
    QFH, DQS, SF, DQB, B1, DQB, SD, DQS,
    QD,
    DQS, SD, DQB, B2, DQB, SF, DQS, QFH
);
USE, PERIOD=FODO;
